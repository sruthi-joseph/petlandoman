{
  "framework": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/pages/about.html", "destination": "/about", "permanent": true },
    { "source": "/pages/all-services.html", "destination": "/all-services", "permanent": true },
    { "source": "/pages/services.html", "destination": "/services", "permanent": true },
    { "source": "/pages/grooming.html", "destination": "/grooming", "permanent": true },
    { "source": "/pages/boarding.html", "destination": "/boarding", "permanent": true },
    { "source": "/pages/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/pages/products.html", "destination": "/products", "permanent": true },
    { "source": "/pages/accessories.html", "destination": "/accessories", "permanent": true },
    { "source": "/pages/hygiene.html", "destination": "/hygiene", "permanent": true },
    { "source": "/pages/pet-food.html", "destination": "/pet-food", "permanent": true },
    { "source": "/pages/toys.html", "destination": "/toys", "permanent": true },
    { "source": "/pages/blog.html", "destination": "/blog", "permanent": true },
    { "source": "/pages/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/pages/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/pages/return-policy.html", "destination": "/return-policy", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/all-services", "destination": "/pages/all-services.html" },
    { "source": "/services", "destination": "/pages/services.html" },
    { "source": "/grooming", "destination": "/pages/grooming.html" },
    { "source": "/boarding", "destination": "/pages/boarding.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/products", "destination": "/pages/products.html" },
    { "source": "/accessories", "destination": "/pages/accessories.html" },
    { "source": "/hygiene", "destination": "/pages/hygiene.html" },
    { "source": "/pet-food", "destination": "/pages/pet-food.html" },
    { "source": "/toys", "destination": "/pages/toys.html" },
    { "source": "/blog", "destination": "/pages/blog.html" },
    { "source": "/privacy", "destination": "/pages/privacy.html" },
    { "source": "/terms", "destination": "/pages/terms.html" },
    { "source": "/return-policy", "destination": "/pages/return-policy.html" },
    { "source": "/static/(.*)", "destination": "/studio/static/$1" },
    { "source": "/vendor/(.*)", "destination": "/studio/vendor/$1" },
    { "source": "/studio/(.*)", "destination": "/studio/index.html" },
    { "source": "/studio", "destination": "/studio/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/frames/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/style.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/script.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/favicon_io/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
